user_data/freqaimodels/
user_data/notebooks/.ipynb_checkpoints/
user_data/plot/

# Generated research artifacts
research/*.png
research/*.parquet
research/discovery_cache/
research/batch_backtest_results.csv

# Normalized data store: regenerated from source adapters on every
# get_price_levels() call, not source data itself.
user_data/normalized/

# Scheduled update_data.sh output (see scripts/update_data.sh, launchd job
# com.pairtrading.update-data)
logs/

# OS
.DS_Store
research/entry_gates_parts/
research/entry_gates_build.log
backups/
research/exit_sweep_paths.parquet_parts/
research/candidate_theta_parts/

# Live paper system runtime state. The book is data, not source -- and on the VM
# it lives in trading_data/, bind-mounted, so a rebuild cannot lose it.
