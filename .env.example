# Copy to .env and fill in real values. .env is gitignored — never commit it.

# OKX API key, created on the live account (OKX authenticates the same key
# against either its demo or live environment — see nautilus/run_paper.py's
# docstring). Sourced automatically by nautilus_trader's OKX adapter. Since
# this is a live-account key, keep its OKX-side permissions scoped to
# read-only / market data (no trade, no withdraw).
OKX_API_KEY=
OKX_API_SECRET=
OKX_API_PASSPHRASE=
