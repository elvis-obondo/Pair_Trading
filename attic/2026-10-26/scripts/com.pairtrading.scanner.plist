<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Runs one universe-scanner cycle every 30 minutes.

  NOT installed automatically. To install:
    cp scripts/com.pairtrading.scanner.plist ~/Library/LaunchAgents/
    launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.pairtrading.scanner.plist

  To check / force / remove:
    launchctl list | grep pairtrading
    launchctl kickstart -k gui/$(id -u)/com.pairtrading.scanner
    launchctl bootout gui/$(id -u)/com.pairtrading.scanner

  Note honestly: on a laptop "24/7" means whenever the Mac is awake and Docker
  Desktop is up. Moving this to the VM is a deliberate later step.

  EDIT THE PATHS BELOW if the repo does not live at /Users/elvisobondo/Pair_Trading.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.pairtrading.scanner</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Users/elvisobondo/Pair_Trading/scripts/run_scanner.sh</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/elvisobondo/Pair_Trading</string>

    <!-- 30 minutes, matching the bar interval. -->
    <key>StartInterval</key>
    <integer>1800</integer>

    <!-- Don't fire on load; run it by hand first and check the output. -->
    <key>RunAtLoad</key>
    <false/>

    <key>StandardOutPath</key>
    <string>/Users/elvisobondo/Pair_Trading/logs/scanner.out.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/elvisobondo/Pair_Trading/logs/scanner.err.log</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>
</dict>
</plist>
